# Copy to .env and fill in. Never commit the real .env (see docs/standards/security.md).

# Where the aggregator reads normalized JSON exports (see
# src/sediment_aggregator/sources/file_based.py for the expected shape).
MEETILY_EXPORT_DIR=/data/meetily
SCREENPIPE_EXPORT_DIR=/data/screenpipe

# Where the daily markdown output is written.
OUTPUT_DIR=/data/output

# Ollama, local by default. If you run Ollama on the host rather than in this
# compose stack, use http://host.docker.internal:11434 on Docker Desktop, or
# your host's LAN/bridge IP on Linux.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Local time (HH:MM) the daily aggregation run fires when using `serve`.
DAILY_RUN_TIME=23:00

# Port for the /status and /healthz endpoints.
STATUS_PORT=8420

LOG_LEVEL=INFO
